{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexKarpinski/VITAO/blob/main/.github/codex/remediation-record.schema.json",
  "title": "Codex review remediation decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "reviewedSha",
    "severity",
    "target",
    "evidence",
    "decision",
    "changedFiles",
    "verification",
    "threadResolution",
    "freshReviewRequired",
    "automation",
    "result"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "type": "string", "enum": ["review", "review-comment", "issue-comment"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "reviewedSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "severity": {
      "type": "string",
      "enum": ["BLOCKER", "MAJOR", "MINOR", "QUESTION", "NON_ACTIONABLE"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "flow": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "type": "string", "enum": ["fix", "challenge", "defer", "escalate"] },
        "reason": { "type": "string", "minLength": 1 },
        "followUpIssue": { "type": "integer", "minimum": 1 }
      }
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "commands"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "not-applicable"]
        },
        "verifiedSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Exact head SHA on which the recorded verification commands ran; required for every applicable verification status, and for a fixed result must be the same commit as result.commitSha."
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "status"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pending", "passed", "failed"] }
            }
          }
        }
      }
    },
    "threadResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canResolve", "reason"],
      "properties": {
        "canResolve": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "freshReviewRequired": { "type": "boolean" },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "fixed", "challenged", "deferred", "escalated", "cancelled"]
        },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "escalation": { "type": "string", "minLength": 1 },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "cancellationReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "fixed" } }, "required": ["status"] },
          "then": { "required": ["commitSha"] }
        },
        {
          "if": { "properties": { "status": { "const": "escalated" } }, "required": ["status"] },
          "then": { "required": ["escalation"] }
        },
        {
          "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] },
          "then": { "required": ["workflowRunId", "cancellationReason"] }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "status": { "enum": ["pending", "passed", "failed"] } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "required": ["verifiedSha"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "status": { "enum": ["passed", "failed"] } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "commands": { "minItems": 1 }
            },
            "required": ["verifiedSha", "commands"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "status": { "const": "not-applicable" } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "commands": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "status": { "const": "fixed" } },
            "required": ["status"]
          }
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": { "const": "passed" },
              "commands": {
                "minItems": 1,
                "items": {
                  "properties": { "status": { "const": "passed" } },
                  "required": ["status"]
                }
              }
            },
            "required": ["verifiedSha", "commands", "status"]
          }
        }
      }
    }
  ]
}
